<Window x:Class="BybitTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#F616181E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="18,14,14,6" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#F7A600" Margin="0,0,9,0" />
                    <TextBlock Text="Bybit на панели задач" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="#F3F6FA" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26"
                        Style="{StaticResource ChipButton}" Padding="0" Click="Close_Click" FontSize="11" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="18,6,18,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="API-КЛЮЧ" />
                    <TextBox x:Name="ApiKeyBox" Style="{StaticResource DarkTextBox}" Height="32" />

                    <TextBlock Style="{StaticResource Label}" Text="API-СЕКРЕТ" Margin="0,12,0,5" />
                    <PasswordBox x:Name="SecretBox" Style="{StaticResource DarkPasswordBox}" Height="32" />

                    <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#7C8595" Margin="0,8,0,0"
                               Text="Нужен ключ с правами только на чтение (Read-Only), раздел «Unified Trading → Account». Секрет хранится зашифрованным через Windows DPAPI." />
                    <Button Content="Создать ключ на bybit.com →" HorizontalAlignment="Left" Padding="0,4"
                            Background="Transparent" BorderThickness="0" Foreground="#5B8DEF" FontSize="11"
                            Cursor="Hand" Click="OpenApiPage_Click" Margin="0,2,0,0" />

                    <TextBlock Style="{StaticResource Label}" Text="АДРЕС API" Margin="0,14,0,5" />
                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource DarkTextBox}" Height="32" />
                    <TextBlock Text="Если ваш регион заблокирован: api.bybit.nl, api.bybitgeorgia.ge, api.bybit-tr.com"
                               TextWrapping="Wrap" FontSize="10.5" Foreground="#7C8595" Margin="0,5,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="ТИП СЧЁТА" />
                            <ComboBox x:Name="AccountCombo" Style="{StaticResource DarkCombo}">
                                <ComboBoxItem Content="UNIFIED" Tag="UNIFIED" />
                                <ComboBoxItem Content="SPOT" Tag="SPOT" />
                                <ComboBoxItem Content="CONTRACT" Tag="CONTRACT" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="ЧТО ПОКАЗЫВАТЬ" />
                            <ComboBox x:Name="MetricCombo" Style="{StaticResource DarkCombo}">
                                <ComboBoxItem Content="Капитал (equity)" Tag="Equity" />
                                <ComboBoxItem Content="Баланс кошелька" Tag="Wallet" />
                                <ComboBoxItem Content="Доступно" Tag="Available" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="ОБНОВЛЕНИЕ" />
                            <ComboBox x:Name="RefreshCombo" Style="{StaticResource DarkCombo}">
                                <ComboBoxItem Content="каждые 15 секунд" Tag="15" />
                                <ComboBoxItem Content="каждую минуту" Tag="60" />
                                <ComboBoxItem Content="каждые 2 минуты" Tag="120" />
                                <ComboBoxItem Content="каждые 5 минут" Tag="300" />
                                <ComboBoxItem Content="каждые 15 минут" Tag="900" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox x:Name="ShowCoinsCheck" Style="{StaticResource DarkCheck}" Content="Показывать монеты"
                                      Margin="0,0,0,10" />
                            <CheckBox x:Name="HideFullscreenCheck" Style="{StaticResource DarkCheck}"
                                      Content="Скрывать в полноэкранном режиме" Margin="0,0,0,10" />
                            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource DarkCheck}"
                                      Content="Запускать с Windows" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" FontSize="11"
                               Foreground="#8A93A3" Margin="0,14,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,12,18,16">
                <Button x:Name="TestBtn" Content="Проверить связь" HorizontalAlignment="Left"
                        Style="{StaticResource ChipButton}" Padding="12,7" Click="Test_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource ChipButton}" Padding="14,7"
                            Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
