<Window x:Class="BybitTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bybit Balance"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <!-- Чип, который висит на панели задач -->
        <Border x:Name="Chip"
                Height="26"
                CornerRadius="8"
                Padding="9,0"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Chip_MouseLeftButtonDown"
                MouseMove="Chip_MouseMove"
                MouseLeftButtonUp="Chip_MouseLeftButtonUp"
                MouseRightButtonUp="Chip_MouseRightButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EE15181E" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F520242C" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#34D399" Margin="0,0,7,0" />
                <TextBlock x:Name="ChipText" Text="…" FontSize="12" FontWeight="SemiBold"
                           Foreground="#F2F6FA" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Карточка с деталями -->
        <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=Chip}" Placement="Top"
               VerticalOffset="-5" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Closed="DetailsPopup_Closed">
            <Border Background="#F616181E" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="12" Padding="14" Margin="10" Width="282">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="HdrAccount" Text="BYBIT · UNIFIED" FontSize="10.5"
                                   Foreground="#8A93A3" VerticalAlignment="Center" />
                        <TextBlock x:Name="HdrUpdated" Text="" FontSize="10.5" Foreground="#8A93A3"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="BigValue" Text="—" FontSize="23" FontWeight="SemiBold"
                               Foreground="#F4F7FB" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Кошелёк" FontSize="11.5" Foreground="#8A93A3" />
                        <TextBlock x:Name="WalletValue" Text="—" FontSize="11.5" Foreground="#D7DEE9"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Доступно" FontSize="11.5" Foreground="#8A93A3" />
                        <TextBlock x:Name="AvailValue" Text="—" FontSize="11.5" Foreground="#D7DEE9"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Нереализ. PnL" FontSize="11.5" Foreground="#8A93A3" />
                        <TextBlock x:Name="PnlValue" Text="—" FontSize="11.5" Foreground="#D7DEE9"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Border x:Name="CoinsSep" Height="1" Background="#1CFFFFFF" Margin="0,8" />
                    <StackPanel x:Name="CoinsPanel" />

                    <TextBlock x:Name="ErrorText" Text="" FontSize="10.5" Foreground="#F87171"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" />

                    <Border Height="1" Background="#1CFFFFFF" Margin="0,10,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshBtn" Content="Обновить" Style="{StaticResource ChipButton}"
                                Click="Refresh_Click" Margin="0,0,6,0" />
                        <Button x:Name="SettingsBtn" Content="Настройки" Style="{StaticResource ChipButton}"
                                Click="Settings_Click" Margin="0,0,6,0" />
                        <Button x:Name="ExitBtn" Content="Выход" Style="{StaticResource ChipButton}"
                                Click="Exit_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Контекстное меню -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=Chip}" Placement="Top"
               VerticalOffset="-5" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="#F616181E" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="5" Margin="10" Width="196">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Button Content="Детали" Style="{StaticResource MenuButton}" Click="MenuDetails_Click" />
                    <Button Content="Обновить сейчас" Style="{StaticResource MenuButton}" Click="Refresh_Click" />
                    <Button Content="Настройки…" Style="{StaticResource MenuButton}" Click="Settings_Click" />
                    <Button Content="Открыть Bybit" Style="{StaticResource MenuButton}" Click="MenuOpenBybit_Click" />
                    <Border Height="1" Background="#1CFFFFFF" Margin="6,5" />
                    <Button Content="Вернуть к трею" Style="{StaticResource MenuButton}" Click="MenuResetPosition_Click" />
                    <Button Content="Скрыть до перезапуска" Style="{StaticResource MenuButton}" Click="MenuHide_Click" />
                    <Button Content="Выход" Style="{StaticResource MenuButton}" Click="Exit_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
